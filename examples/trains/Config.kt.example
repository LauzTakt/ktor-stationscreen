// Local configuration — copy this file to Config.kt and fill it in.
package trains

import esp32.screen.Screen
import esp32.screen.TftPins

const val WIFI_SSID = "my-wifi"
const val WIFI_PASSWORD = "my-password"

/**
 * Base URL of the twin API, e.g. "http://94.130.67.179". Use plain http:// and an IP address: TLS needs ~40 KB of
 * RAM the board does not have next to the Kotlin heap, and an IP avoids the DNS lookup.
 * Empty = the mock API served by `./ktesp screen` on the computer (MOCK_HOST below, port 8765).
 */
const val API_BASE = ""

/** Computer running `./ktesp screen` (only used when API_BASE is empty and the program runs on the ESP32). */
const val MOCK_HOST = "192.168.1.50"

/** Station shown when the board has no `station` setting (UIC/DIDOK id; 8501008 = Genève). */
const val DEFAULT_STATION = "8501008"

/** NTP server used at start-up to set the clock (first thing after WiFi): an IP (time.cloudflare.com), no DNS. */
const val NTP_SERVER = "162.159.200.1"

/** true = no API: the board shows built-in sample data (see Demo.kt); WiFi and NTP are still used if available. */
const val DEMO = true

/**
 * Display: the ILI9341 emulated on the Mac (`./ktesp screen`), or a real one on SPI, e.g.
 *   Screen.ili9341(TftPins.CYD)      ESP32-2432S028R "Cheap Yellow Display"
 *   Screen.ili9341(TftPins.DEVKIT)   ESP32 DevKit + ILI9341 module (SCK18 MOSI23 MISO19 CS15 DC2 RST4)
 */
fun createScreen(): Screen = Screen.simulated(rotation = 1)
